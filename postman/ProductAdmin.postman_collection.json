{
  "info": {
    "name": "Product Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Stateless REST API secured with HTTP Basic Authentication. No cookies, no JSESSIONID and no CSRF token are needed: each folder carries its own Basic Auth credentials (collection variables). Run the collection top to bottom against the running app with the demo data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminName",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "Admin@12345"
    },
    {
      "key": "userName",
      "value": "user"
    },
    {
      "key": "userPassword",
      "value": "User@12345"
    },
    {
      "key": "firstProductId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Registration (public)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Register new user (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman{{$timestamp}}\",\n  \"email\": \"postman{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"confirmPassword\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON (not the login HTML page)', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
                  "pm.test('New accounts are always USER', () => pm.expect(pm.response.json().role).to.eql('USER'));",
                  "pm.test('Password is never returned', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with weak password (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"weakuser\",\n  \"email\": \"weak@example.com\",\n  \"password\": \"abc\",\n  \"confirmPassword\": \"abc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Response is JSON (not the login HTML page)', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. No credentials / wrong credentials",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Unauthorized: GET products without credentials (401 JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "No Authorization header, so the API must answer 401 with JSON, not redirect to the HTML login page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Response is JSON (not the login HTML page)', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
                  "pm.test('Asks for Basic auth', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Basic'));",
                  "pm.test('Not an HTML page', () => pm.expect(pm.response.text()).to.not.include('<html'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized: wrong password (401 JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminName}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "definitely-wrong",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Response is JSON (not the login HTML page)', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));"
                ]
              }
            }
          ]
        }
      ]
    },
