                  "const body = pm.response.json();",
                  "pm.test('Page structure', () => { pm.expect(body.content).to.be.an('array'); pm.expect(body).to.have.property('totalElements'); });",
                  "if (body.content.length) pm.collectionVariables.set('firstProductId', body.content[0].id);"
                ]
              }
            }
