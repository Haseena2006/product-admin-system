# Copy these into your IntelliJ run configuration (Environment variables) or your shell.
# NEVER commit real values.
DB_URL=jdbc:postgresql://localhost:5432/product_admin
DB_USERNAME=postgres
DB_PASSWORD=change_me
# Optional: passwords of the demo ADMIN / USER accounts created on first start
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_PASSWORD=User@123
# Optional: comma separated origins allowed to call /api from another site (empty = same-origin only)
CORS_ALLOWED_ORIGINS=
